{
  "name": "makale",
  "version": "1.0.0",
  "description": "A careful English\u2013Turkish research reading studio for Linux",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "kadirnar",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env MAKALE_DEV=1 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "dist": "npm run build && electron-builder --linux AppImage tar.gz",
    "test:live": "node scripts/live-smoke.mjs",
    "format": "prettier --write src electron tests scripts/*.mjs *.json *.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.7",
    "jsdom": "^26.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "pdfjs-dist": "5.5.207",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.github.kadirnar.makale",
    "productName": "Makale",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "compression": "normal"
  },
  "engines": {
    "node": ">=22.12"
  },
  "homepage": "https://github.com/kadirnar/makale",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadirnar/makale.git"
  },
  "desktopName": "makale.desktop"
}
